{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dkharlanau/sap-agentic-operations/schemas/experiment.schema.json",
  "title": "SAO Experiment Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "result_kind",
    "created_at",
    "benchmark",
    "runtime",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "experiment_id": {"type": "string", "minLength": 3},
    "result_kind": {
      "type": "string",
      "enum": ["reference_self_test", "runtime_evaluation", "simulator_experiment"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "benchmark": {
      "type": "object",
      "required": ["name", "version", "commit"],
      "properties": {
        "name": {"const": "SAO-Bench"},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "case_count": {"type": "integer", "minimum": 1},
        "corpus_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "evaluator_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "adapter": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "model": {
      "type": ["object", "null"],
      "properties": {
        "provider": {"type": "string"},
        "name": {"type": "string"},
        "version": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "agent_config_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "tool_manifest_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "capability_profile": {"type": ["string", "null"]},
    "policy_profile": {"type": ["string", "null"]},
    "simulator": {
      "type": ["object", "null"],
      "properties": {
        "version": {"type": "string"},
        "fixture": {"type": "string"},
        "fault_profile": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["predictions", "report"],
      "properties": {
        "predictions": {"type": "string", "minLength": 1},
        "report": {"type": "string", "minLength": 1},
        "audit": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "runner": {"type": ["string", "null"]},
        "region": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"result_kind": {"const": "runtime_evaluation"}}},
      "then": {
        "required": ["agent_config_sha256", "tool_manifest_sha256", "capability_profile", "policy_profile"]
      }
    }
  ],
  "additionalProperties": false
}
