{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dkharlanau/sap-agentic-operations/schemas/assurance-case.schema.json",
  "title": "SAO Assurance Case",
  "type": "object",
  "required": ["format", "assurance_case_id", "created_at", "subject", "benchmark", "status", "claims", "limitations"],
  "properties": {
    "format": {"const": "sao-assurance-case/0.1"},
    "assurance_case_id": {"type": "string", "minLength": 3},
    "created_at": {"type": "string", "format": "date-time"},
    "subject": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {"type": "string", "enum": ["runtime_configuration", "baseline", "harness"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "experiment_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "benchmark": {
      "type": "object",
      "required": ["name", "version", "case_count", "report_ref"],
      "properties": {
        "name": {"const": "SAO-Bench"},
        "version": {"type": "string"},
        "commit": {"type": ["string", "null"]},
        "case_count": {"type": "integer", "minimum": 1},
        "report_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "trace": {
      "type": ["object", "null"],
      "properties": {
        "version": {"type": "string"},
        "trace_count": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "report_ref": {"type": "string"}
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["bounded_evidence", "control_gaps_detected", "evidence_incomplete", "harness_integrity_only"]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "status", "coverage", "evidence_refs", "failed_case_ids"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["supported_in_current_evidence", "control_gap_detected", "not_evaluated"]
          },
          "threat_classes": {"type": "array", "items": {"type": "string"}},
          "coverage": {
            "type": "object",
            "required": ["cases", "passed", "failed"],
            "properties": {
              "cases": {"type": "integer", "minimum": 0},
              "passed": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "failed_case_ids": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "disclaimer": {"type": "string"}
  },
  "additionalProperties": false
}
