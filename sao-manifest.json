{
  "schemaVersion": "0.3",
  "project": "SAP Agentic Operations",
  "shortName": "SAO",
  "status": "experimental",
  "version": "0.3-dev",
  "maintainer": {
    "name": "Dzmitryi Kharlanau",
    "website": "https://dkharlanau.github.io/",
    "github": "https://github.com/dkharlanau"
  },
  "purpose": "Local-first evidence and operational decision toolkit for SAP-heavy enterprise operations, backed by a vendor-neutral architecture and agent-assurance lab.",
  "practicalToolkit": {
    "name": "SAO Practical Toolkit",
    "version": "0.4.0-alpha.1",
    "install": "python -m pip install .",
    "entrypoint": "sao",
    "python": ">=3.11",
    "runtimeDependencies": 0,
    "writeCapability": false,
    "networkRequiredForCoreWorkflows": false,
    "workflows": [
      "evidence-pack-incident-analysis",
      "one-csv-quick-check",
      "batch-incident-triage",
      "local-read-only-workbench",
      "semantic-master-data-reconciliation",
      "explicit-csv-normalization"
    ],
    "surfaces": {
      "package": "sao_toolkit/",
      "cli": "sao_toolkit/cli.py",
      "evidencePack": "docs/EVIDENCE-PACK.md",
      "quickCheck": "docs/QUICKCHECK.md",
      "reconciliation": "docs/RECONCILIATION.md",
      "normalization": "docs/NORMALIZING-EXPORTS.md",
      "fieldTesting": "docs/FIELD-TESTING.md",
      "productCI": ".github/workflows/product.yml"
    }
  },
  "surfaces": {
    "controlPlane": "docs/CONTROL-PLANE.md",
    "riskModel": "docs/RISK-MODEL.md",
    "conformance": "docs/CONFORMANCE.md",
    "architectureDecisions": "docs/adr/README.md",
    "benchmarkCore": "evals/cases.jsonl",
    "benchmarkPacks": "evals/packs/",
    "benchmarkRunner": "scripts/evaluate_suite.py",
    "benchmarkValidator": "scripts/validate_suite_contracts.py",
    "baselines": "baselines/",
    "adapterProtocol": "adapters/README.md",
    "adapterRunner": "scripts/run_adapter.py",
    "httpAdapter": "adapters/http_endpoint.py",
    "simulator": "simulator/v03.py",
    "experimentProtocol": "experiments/README.md",
    "experimentSchema": "schemas/experiment.schema.json",
    "releaseVersioning": "BENCHMARK_VERSIONING.md",
    "releaseManifestBuilder": "scripts/build_release_manifest.py",
    "roadmap": "ROADMAP.md"
  },
  "schemas": {
    "evidencePack": "schemas/evidence-pack.schema.json",
    "reconciliationPack": "schemas/reconciliation-pack.schema.json",
    "decision": "schemas/decision.schema.json",
    "evidence": "schemas/evidence.schema.json",
    "writeEnvelope": "schemas/write-envelope.schema.json",
    "experiment": "schemas/experiment.schema.json"
  },
  "capabilities": [
    "local-evidence-pack",
    "deterministic-incident-analysis",
    "batch-triage",
    "semantic-reconciliation",
    "explicit-export-normalization",
    "local-read-only-workbench",
    "identity-resolution-gate",
    "evidence-provenance",
    "deterministic-policy-boundary",
    "read-recommend-approve-execute",
    "state-change-safety-envelope",
    "explicit-abstention",
    "runtime-policy-drift",
    "approval-scope-and-expiry",
    "before-state-binding",
    "idempotency-and-collision-detection",
    "postcondition-verification",
    "governed-compensation",
    "tool-output-trust-boundary",
    "memory-trust-and-staleness",
    "threat-class-evaluation",
    "stateful-synthetic-simulation",
    "fault-injection",
    "runtime-neutral-adapters",
    "reproducible-experiment-provenance",
    "benchmark-integrity-manifests"
  ],
  "benchmark": {
    "name": "SAO-Bench",
    "version": "0.3-dev",
    "caseCount": 51,
    "packs": {
      "core": 15,
      "integration-operations": 7,
      "master-data": 7,
      "business-process": 7,
      "agent-security": 7,
      "state-change": 8
    },
    "riskTiers": ["R0", "R1", "R2", "R3", "R4"],
    "threatClasses": ["T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8", "T9", "T10"],
    "frozen": false,
    "resultRequirement": "Development results must include exact Git commit and experiment provenance."
  },
  "simulator": {
    "name": "Synthetic Enterprise Lab",
    "version": "0.3-dev",
    "sapEmulator": false,
    "stateful": true,
    "faultInjection": true
  },
  "independence": "Independent open-source project; not an official SAP project, certification, or production-safety guarantee."
}
